---
layout: null
permalink: /sitemap.xml
---
{%- comment -%}
  Replaces jekyll-sitemap (which skips itself when this file exists): that one
  listed only the English pages. Every translated page is listed once per
  language, with its alternates and last-modified date — all from front matter
  via _plugins/visibility.rb, so a new page appears here by itself.
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for p in site.data.oz_pages %}
{%- assign mod = p.last_modified_date | default: p.date %}
{%- for l in p.langs %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{% if l[0] != site.default_lang %}/{{ l[0] }}{% endif %}{{ l[1] }}</loc>
    {%- if mod %}
    <lastmod>{{ mod | date: "%Y-%m-%d" }}</lastmod>
    {%- endif %}
    {%- if p.langs.size > 1 %}
    {%- for a in p.langs %}
    <xhtml:link rel="alternate" hreflang="{{ a[0] }}" href="{{ site.url }}{{ site.baseurl }}{% if a[0] != site.default_lang %}/{{ a[0] }}{% endif %}{{ a[1] }}"/>
    {%- endfor %}
    {%- endif %}
  </url>
{%- endfor %}
{%- endfor %}
{%- comment -%} Per-model and per-run benchmark pages, _plugins/benchmark-pages.rb. {%- endcomment -%}
{%- for p in site.data.oz_bench_pages %}
{%- for l in p.langs %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{% if l != site.default_lang %}/{{ l }}{% endif %}{{ p.permalink }}</loc>
    {%- if p.langs.size > 1 %}
    {%- for a in p.langs %}
    <xhtml:link rel="alternate" hreflang="{{ a }}" href="{{ site.url }}{{ site.baseurl }}{% if a != site.default_lang %}/{{ a }}{% endif %}{{ p.permalink }}"/>
    {%- endfor %}
    {%- endif %}
  </url>
{%- endfor %}
{%- endfor %}
</urlset>
